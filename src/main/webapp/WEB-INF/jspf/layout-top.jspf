<%@page contentType="text/html" pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'Almacén' : pageTitle}"/></title>

    <!-- Bootstrap 5 -->
    <link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/img/favicon.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha256-PI8n5gCcz9cQqQXm3PEtDuPG8qx9oFsFctPg0S5zb8g=" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha256-pdY4ejLKO67E0CM2tbPtq1DJ3VGDVVdqAR6j3ZwdiE4=" crossorigin="anonymous">
    <link href="${pageContext.request.contextPath}/assets/css/styles.css" rel="stylesheet">
  </head>
  <body>
    <div class="app-shell">
      <nav class="navbar navbar-expand-lg navbar-light bg-white">
        <div class="container">
          <a class="navbar-brand fw-semibold" href="${pageContext.request.contextPath}/ProductosController"><i class="bi bi-box-seam-fill me-1" aria-hidden="true"></i>Almacén</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNavbar" aria-controls="appNavbar" aria-expanded="false" aria-label="Alternar navegación">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="appNavbar">

            <%-- Permission keys here must match seguridad/Permisos.java constants (no compile-time link between them). --%>
            <c:if test="${not empty sessionScope.usuario}">
              <ul class="navbar-nav me-auto">
                <c:if test="${permisos.ver_inventario}">
                  <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/ProductosController"><i class="bi bi-box-seam me-1" aria-hidden="true"></i>Productos</a></li>
                </c:if>
                <c:if test="${permisos.agregar_productos}">
                  <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/ProductosController?accion=nuevo"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Nuevo producto</a></li>
                </c:if>
                <c:if test="${permisos.ver_salida}">
                  <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/ProductosController?accion=salida_productos"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Salidas</a></li>
                </c:if>
                <c:if test="${permisos.ver_historico}">
                  <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/ProductosController?accion=historial"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>Histórico</a></li>
                </c:if>
              </ul>
            </c:if>

            <div class="d-flex align-items-center gap-2 ms-lg-auto">
              <c:if test="${not empty sessionScope.usuario}">
                <span class="text-secondary small d-none d-lg-inline">
                  Usuario: <span class="fw-semibold"><c:out value="${sessionScope.usuario}"/></span>
                </span>
                <a class="btn btn-outline-secondary btn-sm btn-erp" href="LoginController?accion=salir"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Cerrar sesión</a>
              </c:if>
            </div>
          </div>
        </div>
      </nav>

      <main class="app-main py-4">
        <div class="container">
